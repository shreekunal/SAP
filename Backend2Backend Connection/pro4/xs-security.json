{
  "xsappname": "pro4",
  "tenant-mode": "dedicated",
  "description": "Security profile of called application",
  "scopes": [
    {
      "name": "$XSAPPNAME.Display",
      "description": "Display access to UI"
    },
    {
      "name": "$XSAPPNAME.Create",
      "description": "Create access"
    },
    {
      "name": "$XSAPPNAME.Read",
      "description": "Read access"
    },
    {
      "name": "$XSAPPNAME.Update",
      "description": "Update access"
    },
    {
      "name": "$XSAPPNAME.Delete",
      "description": "Delete access"
    }
  ],
  "role-templates": [
    {
      "name": "Viewer",
      "description": "Read only access",
      "scope-references": ["$XSAPPNAME.Display", "$XSAPPNAME.Read"]
    },
    {
      "name": "Editor",
      "description": "Can create and update",
      "scope-references": [
        "$XSAPPNAME.Display",
        "$XSAPPNAME.Read",
        "$XSAPPNAME.Create",
        "$XSAPPNAME.Update"
      ]
    },
    {
      "name": "Admin",
      "description": "Full access",
      "scope-references": [
        "$XSAPPNAME.Display",
        "$XSAPPNAME.Read",
        "$XSAPPNAME.Create",
        "$XSAPPNAME.Update",
        "$XSAPPNAME.Delete"
      ]
    }
  ]
}
